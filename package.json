{
  "name": "vasant-interview-form",
  "version": "1.0.0",
  "description": "Online interview form that emails HR a PDF of each submission",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test-email": "node test-email.js",
    "build:browser": "esbuild browser/entry.js --bundle --platform=browser --format=iife --minify --inject:browser/buffer-shim.js --alias:pdfkit=./node_modules/pdfkit/js/pdfkit.standalone.js --outfile=public/interview-pdf.js"
  },
  "author": "",
  "license": "ISC",
  "private": true,
  "dependencies": {
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.11",
    "pdfkit": "^0.20.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "buffer": "^6.0.3",
    "esbuild": "^0.28.2"
  }
}
